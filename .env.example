# Keys for the Playground "AI tagline" widget. Server-side only: never sent to the browser.
# Copy this file to .env and fill in ONE of them (Claude is used first if both are set).
# Never put real keys in this file: it is committed to git.

# Claude: https://platform.claude.com/ → Settings → API Keys
NUXT_ANTHROPIC_API_KEY=

# Gemini (free tier available): https://aistudio.google.com/app/apikey
NUXT_GEMINI_API_KEY=
GROQ_API_KEY=